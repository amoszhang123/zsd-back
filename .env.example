# Copy to .env and fill in values
APP_NAME=factory
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=factory_erp

# 微信小程序手机号快速验证；两项都填写后才会真正调用微信接口
WX_APPID=
WX_APP_SECRET=
# 本地开发兜底：未配置上面两项时，/api/mp/wx-login 直接返回这个手机号
MP_MOCK_PHONE=

# 出货单（送货单）打印抬头的发货方公司名
SHIP_FROM_COMPANY=
