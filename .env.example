# Copy to .env and fill in values
APP_NAME=factory
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=factory_erp

# root 密码。与应用账号（上面的 DB_USER/DB_PASSWORD）分开：
#   DB_ROOT_PASSWORD = root 的密码，只在建库、运维、部署备份时用
#                       （MySQL 的 root 密码在首次初始化时写入数据目录，之后改这里不会改密码，
#                         所以这里必须填**当初初始化时用的那个值**）
#   DB_PASSWORD      = 应用账号的密码，生产应为 zsd_app（只授权到 factory_erp.*）
# 用专用账号后，deploy.sh 的备份与 healthcheck 仍走 root，不受应用密码变更影响。
DB_ROOT_PASSWORD=your_root_password

# 微信小程序手机号快速验证；两项都填写后才会真正调用微信接口
WX_APPID=
WX_APP_SECRET=
# 本地开发兜底：未配置上面两项时，/api/mp/wx-login 直接返回这个手机号
MP_MOCK_PHONE=

# 小程序提审用的「手机号 + 固定验证码」登录（不发真短信）。
# 默认关闭；关闭时 /api/mp/sms-code 与 /api/mp/sms-login 直接返回 404。
# 提审期间打开并填好测试号，审核结束把 ENABLED 改回 false 即可。
MP_SMS_TEST_ENABLED=false
MP_SMS_TEST_PHONE=
MP_SMS_TEST_CODE=

# 出货单（送货单）打印抬头的发货方公司名
SHIP_FROM_COMPANY=

# ============ 安全相关（生产必配） ============

# web 后台登录账号。格式：用户名:密码哈希:姓名:角色:岗位，多个用 ; 分隔。
# 密码哈希用这条命令生成（不要填明文）：
#   .venv/bin/python -m app.make_password 你的密码
#
# ⚠ 哈希里有 $，.env 给 docker compose 读时会被当成变量替换，
#   必须每个 $ 写成 $$（make_password 的输出已经是 $$ 格式，直接粘即可）。
#   写错的表现是：容器能起来，但登录一直失败，日志里只有一行 WARN
#   "variable is not set. Defaulting to a blank string"。
# 例：
#   WEB_USERS=admin:scrypt$xxx:管理员:admin:管理员;operator:scrypt$yyy:操作员:operator:操作工
# 不配会回落到内置默认账号 admin/admin123（启动日志会警告），生产务必配置。
# 改完必须 `docker compose up -d`（restart 不重读 env_file）；
# 改密码后所有旧 token 立即失效，所有人需重新登录一次。
WEB_USERS=

# 允许跨域访问的前端地址，逗号分隔。留空则只允许 https://zsd-fab.com 与本地 5174。
# 之前是 ["*"]（任何网站都能在浏览器里直接调后端），现已改为白名单。
CORS_ORIGINS=


# ============ 数据库备份（生产必配） ============
# 备份专用账号：只读 + LOCK TABLES，删不掉任何数据。
# 先用 scripts/init-db-users.sql 建好这个账号，再把密码填这里。
DB_BACKUP_USER=zsd_backup
DB_BACKUP_PASSWORD=

# 备份同步到阿里云 OSS 的 bucket 名（留空则只备份到本机——硬件故障时会一起丢失）
# 注意：给 ossutil 用的 AccessKey 只能是 PutObject 权限，不要给 Delete，
# 这样脚本被篡改也删不掉异地副本。清理靠 bucket 生命周期规则。
OSS_BUCKET=
OSS_PREFIX=db-backup

# 微信告警 webhook（可选）。写了就推备份失败/演练异常，不写只留日志。
# 换行敏感的地址建议写进 .webhook 文件，脚本会自动读。
WEBHOOK=
